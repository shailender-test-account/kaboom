# Documentation only. Add real secrets directly in Render -> Environment.
# The app does not automatically read this file. Never commit a populated .env.
NODE_ENV=production
BASE_PATH=/
# Render supplies PORT and RENDER_EXTERNAL_URL automatically.
# Set BASE_URL only when using your NEW custom HTTPS domain.
BASE_URL=
DATABASE_URL=
SESSION_SECRET=
RENDER_DATA_READY=false
COPIED_DATA_SAFE_MODE=true
MONITORING_RESEARCH_ENABLED=false
HP_WARM_JOURNEY_ROUTING_ENABLED=false
HP_RULE_SEQUENCE_ROUTING_ENABLED=false
SALES_FEEDBACK_SYNC_ENABLED=false
USER_WELCOME_EMAIL_ENABLED=false
AUTO_APPLY_SCHEMA_DRIFT=false

# Do NOT add provider credentials during initial restoration/validation.
# Optional future independent AI connection, never a Replit proxy key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Needed only for a separately approved integration rollout, still read-only here:
INTEGRATION_CREDENTIAL_KEYS=
RESEND_TRANSPORT=api_key
RESEND_API_KEY=
FROM_EMAIL=
FROM_NAME=
# Redis, Google Drive OAuth, Perplexity and uploaded-file storage require the
# separate setup described in README-RENDER.md. Do not reuse the original queues.
