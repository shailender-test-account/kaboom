{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
 "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "research:reassess": "node scripts/run-research-reassessment.mjs",
    "test": "vitest run",
    "test:e2e": "bash e2e/libs/build-gbm-stub.sh /tmp && LD_LIBRARY_PATH=/tmp:${LD_LIBRARY_PATH:-} playwright test",
    "test:e2e:hp-crm": "pnpm run test:e2e hp-crm.e2e.ts",
    "test:e2e:intent-detail": "pnpm run test:e2e intent-account-detail.e2e.ts"
  },
  "dependencies": {
    "@clerk/express": "^2.1.12",
    "@clerk/shared": "^4.9.0",
    "@google-cloud/storage": "^7.19.0",
    "@replit/connectors-sdk": "^0.7.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "adm-zip": "^0.6.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.76.5",
    "connect-pg-simple": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-session": "^1.19.0",
    "google-auth-library": "^10.6.2",
    "http-proxy-middleware": "^3.0.7",
    "ioredis": "^5.10.1",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.6",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.20.0",
    "pino": "^9",
    "pino-http": "^10",
    "resend": "^6.12.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "catalog:",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.18.0",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "supertest": "^7.2.2",
    "thread-stream": "3.1.0",
    "vitest": "^4.1.11"
  }
